# 环境变量模板
# 复制为 .env.production（生产）或 .env.local（本地）后按需修改
#   cp .env.example .env.production

# --- 数据库 ---
# 注意：此密码必须与 gin-vue-admin/server/config.yaml 的 mysql.password 一致
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=starNotepad
# MYSQL_PORT=3306

# --- 阿里云 ACR 镜像（生产）---
GVA_SERVER_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:gva-server-latest
ADMIN_WEB_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:admin-web-latest
HOME_WEB_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:home-web-latest
BLOG_FRONTEND_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:blog-frontend-latest
DUO_CALL_WEB_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:duo-call-web-latest
BLUEMAP_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:bluemap-jre-25

# --- 端口 ---
# WEB_PORT=80
# HTTPS_PORT=443
BLUEMAP_PORT=8100
# GVA_SERVER_PORT=8888    # 仅本地开发
# HOME_WEB_PORT=3000      # 仅本地开发
# ADMIN_WEB_DEV_PORT=5173 # 仅本地开发
# BLOG_FRONTEND_PORT=3001 # 仅本地开发
# DUO_CALL_WEB_PORT=3002  # 仅本地开发

# --- 代理（生产通常留空）---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- 应用 ---
NODE_ENV=production
BLOG_PROFILE_API_URL=http://gva-server:8888/api/bc/getUserBlog_configPublic
MAIN_IMAGE_API_URL=http://gva-server:8888/api/mainImage/public

# --- GVA 与爱情小屋安全配置（生产必须修改）---
GVA_JWT_SIGNING_KEY=replace_with_random_value
GVA_EMAIL_SECRET=
DUO_CALL_JWT_SECRET=replace_with_random_value
DUO_CALL_KEY_ENCRYPTION_KEY=replace_with_random_value

# --- 情侣每日回信 / 微信公众平台测试号 ---
WX_TEST_ENABLED=false
WX_TEST_APPID=
WX_TEST_SECRET=
WX_TEST_TEMPLATE_ID=
DUO_PUBLIC_BASE_URL=https://ai.xiaoyu.ski

# --- WebRTC / TURN ---
DUO_TURN_HOST=turn.xiaoyu.ski
DUO_TURN_USERNAME=duo
DUO_TURN_PASSWORD=replace_with_random_value
TURN_EXTERNAL_IP=82.157.105.7
