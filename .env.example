# 环境变量模板
# 复制为 .env.production（生产）或 .env.local（本地）后按需修改
#   cp .env.example .env.production

# --- 数据库 ---
# 注意：此密码必须与 gin-vue-admin/server/config.yaml 的 mysql.password 一致
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=starNotepad
# MYSQL_PORT=3306

# --- 阿里云 ACR 镜像（生产）---
GVA_SERVER_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:gva-server-latest
ADMIN_WEB_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:admin-web-latest
HOME_WEB_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:home-web-latest
BLUEMAP_IMAGE=crpi-nxt6ib76b78qk7wc.cn-beijing.personal.cr.aliyuncs.com/charles1337/charles:bluemap-jre-25

# --- 端口 ---
# WEB_PORT=80
BLUEMAP_PORT=8100
# GVA_SERVER_PORT=8888    # 仅本地开发
# HOME_WEB_PORT=3000      # 仅本地开发
# ADMIN_WEB_DEV_PORT=5173 # 仅本地开发

# --- 代理（生产通常留空）---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- 应用 ---
NODE_ENV=production
BLOG_PROFILE_API_URL=http://gva-server:8888/api/bc/getUserBlog_configPublic
