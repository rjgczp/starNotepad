# In local Docker development, use the API proxy hostname if a reverse proxy is configured.
VITE_DUO_API_URL=/api
# Optional local fallback accepted by RTCPeerConnection. Production obtains ICE
# servers from the authenticated backend bootstrap response.
VITE_DUO_ICE_SERVERS=[{"urls":"stun:turn.xiaoyu.ski:3478"},{"urls":"turn:turn.xiaoyu.ski:3478?transport=udp","username":"replace-me","credential":"replace-me"}]
