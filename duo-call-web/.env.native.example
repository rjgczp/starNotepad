# Bundled Android and desktop webviews cannot use the hosted site's relative
# /api proxy. Copy this file to .env.native before packaging.
VITE_DUO_NATIVE=true
VITE_DUO_API_URL=https://ai.xiaoyu.ski/api

# Optional local fallback accepted by RTCPeerConnection. Production normally
# receives short-lived TURN credentials from the authenticated backend.
VITE_DUO_ICE_SERVERS=[{"urls":"stun:turn.xiaoyu.ski:3478"}]
